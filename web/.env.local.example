# Copy to .env.local and fill in.

# Supabase project URL, e.g. https://abcxyz.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key. Safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App Store listing for the iOS app. Replace id0000000000 with the real ID once available.
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/plano/id0000000000

# TEAMID.bundle for AASA. e.g. ABCDE12345.com.plano.app
APP_BUNDLE_ID_FULL=TEAMID.com.plano.app
